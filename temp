name: Deploy iOS App to TestFlight

on:
  push:
    branches:
      - master
      - main     # Triggers on push to master or main branch
  workflow_dispatch:  # Enables manual trigger from GitHub Actions tab

jobs:
  build_and_deploy:
    runs-on: macos-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.2'
          bundler-cache: true  # Disable bundler caching to avoid potential issues with native extensions

      - name: Set up Xcode
        run: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer

      - name: Install Dependencies
        run: bundle install
        
      # this is used when you use already downloaded certificate file in the repo
      - name: Decode Certificate
        run: echo "$BUILD_CERTIFICATE_BASE64" | base64 --decode > fastlane/certificate.p12
        env:
          BUILD_CERTIFICATE_BASE64: ${{ secrets.BUILD_CERTIFICATE_BASE64 }}

      - name: Run Fastlane Release
        env:
          APPSTORE_ISSUER_ID: ${{ secrets.APPSTORE_ISSUER_ID }}
          APPSTORE_KEY_ID: ${{ secrets.APPSTORE_KEY_ID }}
          APPSTORE_PRIVATE_KEY: ${{ secrets.APPSTORE_PRIVATE_KEY }}
          TEAM_ID: ${{ secrets.TEAM_ID }} # Optional: Pass Team ID from secrets
        run: bundle exec fastlane release

